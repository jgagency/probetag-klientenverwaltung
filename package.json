{
  "name": "probetag-klientenverwaltung",
  "version": "1.0.0",
  "description": "Backend für den Probetag: Klientenverwaltung (Express + PostgreSQL)",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:seed": "sequelize-cli db:seed:all",
    "db:reset": "docker compose down -v && docker compose up -d --wait && npm run db:migrate && npm run db:seed"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@angular/build": "21.2.20",
    "@angular/cli": "21.2.20",
    "@angular/common": "21.2.19",
    "@angular/compiler": "21.2.19",
    "@angular/compiler-cli": "21.2.19",
    "@angular/core": "21.2.19",
    "@angular/forms": "21.2.19",
    "@angular/platform-browser": "21.2.19",
    "@angular/router": "21.2.19",
    "better-auth": "^1.6.26",
    "bootstrap": "^5.3.8",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "ngx-bootstrap": "^21.2.1",
    "pg": "^8.23.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "sequelize-cli": "^6.6.5"
  }
}
